# Base URL of the backend API
REACT_APP_API_URL=http://localhost:8000

# Stripe publishable key (safe to expose on the client)
REACT_APP_STRIPE_PUBLISH_KEY=pk_test_your_stripe_publishable_key

# Google OAuth client ID (for Google login/signup)
REACT_APP_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
