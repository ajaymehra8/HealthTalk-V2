# Server port
PORT=8000

# MongoDB connection string
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbName>?retryWrites=true&w=majority

# JWT secret used to sign auth tokens (use a long random string)
JWT_SECRET=your_jwt_secret_here

# firebase details (legacy)
API_KEY=your_firebase_api_key
AUTH_DOMAIN=your_project.firebaseapp.com
PROJECT_ID=your_project_id
STORAGE_BUCKET=your_project.appspot.com
MESSAGING_SENDER_ID=your_sender_id
APP_ID=your_app_id
MEASURMENT_ID=your_measurement_id

# cloudinary details (file/image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# stripe details (payments)
STRIPE_SECRET=sk_test_your_stripe_secret_key

# email details (nodemailer / mailtrap or SMTP)
Email_Username=your_email_username
Email_Password=your_email_password
Email_Host=sandbox.smtp.mailtrap.io
Email_Port=2525

# stripe webhook secret (from `stripe listen` or dashboard)
WEBHOOK_SECRET=whsec_your_webhook_secret

# Google OAuth credentials
CLIENT_SECRET=your_google_oauth_client_secret
CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# frontend base URL (used in Stripe redirect + emails)
BASE_URL=http://localhost:3000

# chat encryption key (AES-256-GCM, 32-byte value as 64 hex chars)
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHAT_ENCRYPTION_KEY=your_64_char_hex_key

# AI chatbot (FREE Google Gemini tier) - get a free key (no card) at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
